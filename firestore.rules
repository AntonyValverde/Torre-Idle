rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Letras (con tildes y ñ), números, espacio, guion, guion bajo y punto. Sin caracteres invisibles.
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 20
        && n.matches('^[\\p{L}\\p{N} _.\\-]+$')
        && !n.matches('^ .*|.* $');
    }

    function incoming() {
      return request.resource.data;
    }

    function onlyChanged(keys) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ------------------------------------------------------------------
    // Partida guardada: solo el dueño puede leerla y escribirla.
    // ------------------------------------------------------------------
    match /users/{uid} {
      // Una marca de tiempo es válida si no está, no cambió, o la pone el servidor ahora.
      function serverTime(d, old, field) {
        return !(field in d) || (field in old && d[field] == old[field]) || d[field] == request.time;
      }

      function validUser() {
        let d = incoming();
        let old = resource == null ? {} : resource.data;
        return d.keys().hasOnly(['state', 'name', 'totalEarned', 'savedAt', 'ping'])
          && (!('state' in d) || d.state is map)
          && (!('name' in d) || validName(d.name))
          && (!('totalEarned' in d) || (d.totalEarned is number && d.totalEarned >= 0))
          && serverTime(d, old, 'savedAt')
          && serverTime(d, old, 'ping');
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUser();
      // El progreso total nunca puede bajar: evita que un dispositivo con una partida
      // más antigua sobrescriba la buena (el juego detecta el rechazo y recarga la nube).
      allow update: if isOwner(uid) && validUser()
        && (!('totalEarned' in resource.data) || !('totalEarned' in incoming())
            || incoming().totalEarned >= resource.data.totalEarned);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Rankings globales. Cada jugador tiene un único documento y solo puede subir su récord.
    // ------------------------------------------------------------------
    match /leaderboards/{board}/scores/{uid} {
      function validScore() {
        let s = incoming().score;
        return (board == 'stack' && s is int && s >= 0 && s <= 1000)
          || (board == 'merge' && s is int && s >= 0 && s <= 4000000)
          || (board == 'city' && s is number && s >= 0)
          || (board == 'stars' && s is int && s >= 0 && s <= 1000000000)
          || (board == 'thief' && s is int && s >= 0 && s <= 3000)
          || (board == 'traffic' && s is int && s >= 0 && s <= 5000)
          || (board == 'memory' && s is int && s >= 0 && s <= 500);
      }

      function validEntry() {
        return incoming().keys().hasOnly(['name', 'score', 'updatedAt'])
          && validName(incoming().name)
          && incoming().updatedAt == request.time
          && validScore();
      }

      allow read: if true;
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid) && (
        // Nuevo récord (como mucho una vez cada 5 s)
        (validEntry()
          && incoming().score > resource.data.score
          && request.time > resource.data.updatedAt + duration.value(5, 's'))
        // O solo cambio de nombre
        || (onlyChanged(['name']) && validName(incoming().name))
      );
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Retos diarios (Apagón en /daily, Conecta las calles en /roads):
    // un único resultado por jugador y día.
    // ------------------------------------------------------------------

    // Solo se aceptan resultados del día actual (±36 h por las zonas horarias),
    // para que nadie publique resultados de días futuros o pasados.
    function dateIsCurrent(date) {
      let parts = date.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return math.abs(day.toMillis() + 43200000 - request.time.toMillis()) < 129600000;
    }

    function validDailyResult(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dateIsCurrent(date)
        && incoming().keys().hasOnly(['name', 'moves', 'timeMs', 'score', 'createdAt'])
        && validName(incoming().name)
        && incoming().moves is int && incoming().moves >= 1 && incoming().moves <= 999
        && incoming().timeMs is int && incoming().timeMs <= 9999999
        // Un humano necesita al menos ~0,25 s por toque
        && incoming().timeMs >= 1000 && incoming().timeMs >= incoming().moves * 250
        && incoming().score == incoming().moves * 10000000 + incoming().timeMs
        && incoming().createdAt == request.time;
    }

    match /daily/{date}/scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validDailyResult(date);
      // El resultado no se puede cambiar, solo el nombre
      allow update: if isOwner(uid) && onlyChanged(['name']) && validName(incoming().name);
      allow delete: if false;
    }

    match /roads/{date}/scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validDailyResult(date);
      allow update: if isOwner(uid) && onlyChanged(['name']) && validName(incoming().name);
      allow delete: if false;
    }

    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

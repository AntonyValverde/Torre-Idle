rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Letras (con tildes y ñ), números, espacio, guion, guion bajo y punto. Sin caracteres invisibles.
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 20
        && n.matches('^[\\p{L}\\p{N} _.\\-]+$')
        && !n.matches('^ .*|.* $');
    }

    function incoming() {
      return request.resource.data;
    }

    function onlyChanged(keys) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Administrador: la cuenta de Google verificada del creador del juego. Se compara el hash
    // SHA-256 del correo para no publicarlo en el repositorio.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && hashing.sha256(request.auth.token.get('email', '')).toHexString().lower()
          == '928c5ac9da8be9636a8affbd17b145b535acd327d419b4280916f48fbfae1d0e';
    }

    // Documento que solo el administrador puede leer: el juego lo usa para saber si mostrar el panel.
    match /admin/{doc} {
      allow read: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Partida guardada: solo el dueño puede leerla y escribirla.
    // ------------------------------------------------------------------
    match /users/{uid} {
      // Una marca de tiempo es válida si no está, no cambió, o la pone el servidor ahora.
      function serverTime(d, old, field) {
        return !(field in d) || (field in old && d[field] == old[field]) || d[field] == request.time;
      }

      function validUser() {
        let d = incoming();
        let old = resource == null ? {} : resource.data;
        return d.keys().hasOnly(['state', 'name', 'totalEarned', 'savedAt', 'ping'])
          && (!('state' in d) || d.state is map)
          && (!('name' in d) || validName(d.name))
          && (!('totalEarned' in d) || (d.totalEarned is number && d.totalEarned >= 0))
          && serverTime(d, old, 'savedAt')
          && serverTime(d, old, 'ping');
      }

      // Cuenta eliminada por el administrador: la partida se sustituye por esta marca y nada más.
      // El juego del jugador la ve al leer su partida y borra también lo que tiene en el dispositivo.
      function tombstone() {
        let d = incoming();
        return d.keys().hasOnly(['deleted', 'deletedAt'])
          && d.deleted == true
          && d.deletedAt == request.time;
      }

      // El administrador puede leer las partidas para el panel (no modificarlas, solo eliminar la cuenta)
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validUser();
      // El progreso total nunca puede bajar: evita que un dispositivo con una partida
      // más antigua sobrescriba la buena (el juego detecta el rechazo y recarga la nube).
      allow update: if isOwner(uid) && validUser()
        && !('deleted' in resource.data)
        && (!('totalEarned' in resource.data) || !('totalEarned' in incoming())
            || incoming().totalEarned >= resource.data.totalEarned);
      allow create, update: if isAdmin() && request.auth.uid != uid && tombstone();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Rankings globales. Cada jugador tiene un único documento y solo puede subir su récord.
    // ------------------------------------------------------------------
    match /leaderboards/{board}/scores/{uid} {
      function validScore() {
        let s = incoming().score;
        return (board == 'stack' && s is int && s >= 0 && s <= 1000)
          || (board == 'merge' && s is int && s >= 0 && s <= 4000000)
          || (board == 'city' && s is number && s >= 0)
          || (board == 'stars' && s is int && s >= 0 && s <= 1000000000)
          || (board == 'thief' && s is int && s >= 0 && s <= 3000)
          || (board == 'traffic' && s is int && s >= 0 && s <= 5000)
          || (board == 'memory' && s is int && s >= 0 && s <= 500)
          || (board == 'fire' && s is int && s >= 0 && s <= 5000)
          || (board == 'metro' && s is int && s >= 0 && s <= 5000)
          || (board == 'towers' && s is int && s >= 0 && s <= 5000);
      }

      function validEntry() {
        return incoming().keys().hasOnly(['name', 'score', 'updatedAt'])
          && validName(incoming().name)
          && incoming().updatedAt == request.time
          && validScore();
      }

      allow read: if true;
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid) && (
        // Nuevo récord (como mucho una vez cada 5 s)
        (validEntry()
          && incoming().score > resource.data.score
          && request.time > resource.data.updatedAt + duration.value(5, 's'))
        // O solo cambio de nombre
        || (onlyChanged(['name']) && validName(incoming().name))
      );
      // Solo el administrador puede quitar a alguien del ranking (moderación de trampas)
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Retos diarios (Apagón en /daily, Conecta las calles en /roads, Plan verde en /parks):
    // un único resultado por jugador y día.
    // ------------------------------------------------------------------

    // Solo se aceptan resultados del día actual (±36 h por las zonas horarias),
    // para que nadie publique resultados de días futuros o pasados.
    function dateIsCurrent(date) {
      let parts = date.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return math.abs(day.toMillis() + 43200000 - request.time.toMillis()) < 129600000;
    }

    // Ventana asimétrica para fechas que el móvil calcula con su día local: la medianoche local (como UTC)
    // no puede ir más de 14 h por delante del servidor (UTC+14) ni quedar más de 36 h atrás.
    // Así no se puede declarar un día futuro para cobrar sus reclutas antes de tiempo.
    function dayNotFuture(date) {
      let parts = date.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return day.toMillis() <= request.time.toMillis() + 50400000
        && day.toMillis() >= request.time.toMillis() - 129600000;
    }

    function validDailyResult(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dateIsCurrent(date)
        && incoming().keys().hasOnly(['name', 'moves', 'timeMs', 'score', 'createdAt'])
        && validName(incoming().name)
        && incoming().moves is int && incoming().moves >= 1 && incoming().moves <= 999
        && incoming().timeMs is int && incoming().timeMs <= 9999999
        // Un humano necesita al menos ~0,25 s por toque
        && incoming().timeMs >= 1000 && incoming().timeMs >= incoming().moves * 250
        && incoming().score == incoming().moves * 10000000 + incoming().timeMs
        && incoming().createdAt == request.time;
    }

    match /daily/{date}/scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validDailyResult(date);
      // El resultado no se puede cambiar, solo el nombre
      allow update: if isOwner(uid) && onlyChanged(['name']) && validName(incoming().name);
      allow delete: if isAdmin();
    }

    match /roads/{date}/scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validDailyResult(date);
      allow update: if isOwner(uid) && onlyChanged(['name']) && validName(incoming().name);
      allow delete: if isAdmin();
    }

    match /parks/{date}/scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validDailyResult(date);
      allow update: if isOwner(uid) && onlyChanged(['name']) && validName(incoming().name);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Ciudades públicas: lo que se ve al visitar la ciudad de otro jugador.
    // Cualquiera puede leerlas; cada jugador solo escribe la suya (como mucho cada 30 s).
    // ------------------------------------------------------------------
    match /cities/{uid} {
      function validCity() {
        let d = incoming();
        return d.keys().hasOnly(['name', 'era', 'layout', 'buildings', 'earned', 'stars', 'cups', 'gifts', 'conq', 'updatedAt'])
          && d.keys().hasAll(['name', 'era', 'layout', 'buildings', 'earned', 'stars', 'updatedAt'])
          && validName(d.name)
          && d.era is int && d.era >= 1 && d.era <= 1000000
          // Tamaño de cada tipo de edificio (0-4), separados por comas
          && d.layout is string && d.layout.matches('^[0-4](,[0-4]){0,31}$')
          && d.buildings is int && d.buildings >= 0 && d.buildings <= 1000000000
          && d.earned is number && d.earned >= 0
          && d.stars is number && d.stars >= 0
          // Copa de Alcaldes: "oro,plata,bronce" o "oro,plata,bronce,temporadas" (opcional: versiones anteriores no lo envían)
          && (!('cups' in d) || (d.cups is string && d.cups.matches('^[0-9]{1,5}(,[0-9]{1,5}){2,3}$')))
          // Regalos recibidos (❤️): opcional, las versiones anteriores no lo envían
          && (!('gifts' in d) || (d.gifts is int && d.gifts >= 0 && d.gifts <= 10000000))
          // Temporadas de Conquista ganadas (bandera en la ciudad): opcional
          && (!('conq' in d) || (d.conq is int && d.conq >= 0 && d.conq <= 10000))
          && d.updatedAt == request.time;
      }

      allow read: if true;
      allow create: if isOwner(uid) && validCity();
      allow update: if isOwner(uid) && validCity() && request.time > resource.data.updatedAt + duration.value(30, 's');
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Regalos entre ciudades: gifts/{destinatario}/inbox/{remitente}.
    // Cada remitente tiene un único documento por ciudad y solo puede renovarlo en otro día:
    // un regalo al día por ciudad. Solo el destinatario lee su buzón.
    // ------------------------------------------------------------------
    match /gifts/{toUid}/inbox/{fromUid} {
      function validGift() {
        let d = incoming();
        return d.keys().hasOnly(['name', 'day', 'createdAt'])
          && d.keys().hasAll(['name', 'day', 'createdAt'])
          && validName(d.name)
          && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && dateIsCurrent(d.day)
          && d.createdAt == request.time
          && fromUid != toUid
          // Solo a ciudades que existen (que se pueden visitar)
          && exists(/databases/$(database)/documents/cities/$(toUid));
      }

      allow read: if isOwner(toUid) || isAdmin();
      allow create: if isOwner(fromUid) && validGift();
      // Solo se renueva en un día posterior: alternar hoy/mañana no vale para regalar dos veces
      allow update: if isOwner(fromUid) && validGift() && incoming().day > resource.data.day;
      allow delete: if isOwner(toUid) || isAdmin();
    }

    // ------------------------------------------------------------------
    // Liga semanal: un documento por jugador y semana (identificada por su lunes).
    // Los puntos salen de misiones y retos diarios (máximo 1000) y solo pueden subir.
    // ------------------------------------------------------------------
    match /league/{week}/scores/{uid} {
      // Solo la semana en curso (±36 h por las zonas horarias) y siempre un lunes
      function weekIsCurrent() {
        let parts = week.split('-');
        let monday = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
        return monday.dayOfWeek() == 1
          && request.time.toMillis() > monday.toMillis() - 129600000
          && request.time.toMillis() < monday.toMillis() + 604800000 + 129600000;
      }

      function validLeague() {
        return week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && weekIsCurrent()
          && incoming().keys().hasOnly(['name', 'score', 'updatedAt'])
          && validName(incoming().name)
          && incoming().score is int && incoming().score >= 1 && incoming().score <= 1000
          && incoming().updatedAt == request.time;
      }

      allow read: if true;
      allow create: if isOwner(uid) && validLeague();
      allow update: if isOwner(uid) && (
        (validLeague()
          && incoming().score > resource.data.score
          && request.time > resource.data.updatedAt + duration.value(5, 's'))
        || (onlyChanged(['name']) && validName(incoming().name))
      );
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Copa de Alcaldes: una por semana, identificada por su lunes, en hora de Costa Rica (UTC-6).
    //   Lunes a viernes: inscripción. Sábado: grupos (g1, g2, g3). Domingo: final (f).
    // Fuera de su horario no se puede escribir nada: así todos ven los mismos grupos y resultados.
    // ------------------------------------------------------------------
    function cupWeekOk(week) {
      let p = week.split('-');
      return week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(p[0]), int(p[1]), int(p[2])).dayOfWeek() == 1;
    }

    // Milisegundos desde el lunes a las 00:00 hora de Costa Rica (06:00 UTC)
    function cupElapsed(week) {
      let p = week.split('-');
      return request.time.toMillis() - (timestamp.date(int(p[0]), int(p[1]), int(p[2])).toMillis() + 21600000);
    }

    function cupSignup(week) {
      return cupElapsed(week) >= 0 && cupElapsed(week) < 432000000;
    }

    function cupGroups(week) {
      return cupElapsed(week) >= 432000000 && cupElapsed(week) < 518400000;
    }

    function cupFinal(week) {
      return cupElapsed(week) >= 518400000 && cupElapsed(week) < 604800000;
    }

    match /cup/{week}/entries/{uid} {
      function validEntry() {
        let d = incoming();
        return d.keys().hasOnly(['name', 'tier', 'gold', 'silver', 'bronze', 'createdAt'])
          && d.keys().hasAll(['name', 'tier', 'gold', 'silver', 'bronze', 'createdAt'])
          && validName(d.name)
          && d.tier is int && d.tier >= 0 && d.tier <= 400
          && d.gold is int && d.gold >= 0 && d.gold <= 99999
          && d.silver is int && d.silver >= 0 && d.silver <= 99999
          && d.bronze is int && d.bronze >= 0 && d.bronze <= 99999
          && d.createdAt == request.time;
      }

      allow read: if true;
      allow create: if isOwner(uid) && cupWeekOk(week) && cupSignup(week) && validEntry();
      // Después solo se puede cambiar el nombre (los grupos dependen del resto)
      allow update: if isOwner(uid) && onlyChanged(['name']) && validName(incoming().name);
      // El administrador puede descalificar solo antes de que se formen los grupos
      allow delete: if isAdmin() && cupWeekOk(week) && cupSignup(week);
    }

    match /cup/{week}/results/{uid} {
      function cupScore(d, k) {
        return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= 5000);
      }

      // Cada marca solo puede subir; si no cambia, da igual el día
      function notDown(d, old, k) {
        return d.get(k, 0) >= old.get(k, 0);
      }

      function same(d, old, k) {
        return d.get(k, 0) == old.get(k, 0);
      }

      function validResult() {
        let d = incoming();
        let old = resource == null ? {} : resource.data;
        return d.keys().hasOnly(['name', 'g1', 'g2', 'g3', 'f', 'updatedAt'])
          && validName(d.name)
          && d.updatedAt == request.time
          && exists(/databases/$(database)/documents/cup/$(week)/entries/$(uid))
          && cupScore(d, 'g1') && cupScore(d, 'g2') && cupScore(d, 'g3') && cupScore(d, 'f')
          && notDown(d, old, 'g1') && notDown(d, old, 'g2') && notDown(d, old, 'g3') && notDown(d, old, 'f')
          && (cupGroups(week) || (same(d, old, 'g1') && same(d, old, 'g2') && same(d, old, 'g3')))
          && (cupFinal(week) || same(d, old, 'f'))
          && (resource == null || request.time > resource.data.updatedAt + duration.value(5, 's'));
      }

      allow read: if true;
      allow create, update: if isOwner(uid) && cupWeekOk(week) && validResult();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Conquista: una temporada por semana (la de la Copa, hora de Costa Rica) en mundos de hasta 16.
    //   conquest/{lunes}/members/{uid}             en qué mundo juega cada alcalde (no cambia)
    //   conquest/{lunes}/worlds/{w}                cuántos alcaldes tiene el mundo
    //   conquest/{lunes}/worlds/{w}/players/{uid}  reserva de tropas del alcalde
    //   conquest/{lunes}/worlds/{w}/tiles/{q_r}    territorios con dueño (los de bandidos no tienen documento)
    // Las reglas hacen de árbitro con las mismas cifras que src/game/conquest.ts: se ataca desde un territorio
    // propio con sus soldados (crecen 1 cada 4 min hasta 30; la capital, 1 cada 2 min hasta 60), la reserva
    // (1 cada 3 min hasta 60, más reclutas) solo refuerza, vecindad en la cuadrícula hexagonal y escudo de
    // 30 min tras una conquista. El asalto (minijuego) multiplica la fuerza hasta x1,5, uno cada 10 min.
    // Solo cuentan comparaciones: "x <= min(a, b)" se escribe "x <= a && x <= b".
    // ------------------------------------------------------------------
    function conqOpen(week) {
      return cupWeekOk(week) && cupElapsed(week) >= 0 && cupElapsed(week) < 604800000;
    }

    function conqDoc(week, w, kind, id) {
      return /databases/$(database)/documents/conquest/$(week)/worlds/$(w)/$(kind)/$(id);
    }

    function conqSlots() {
      return ['-4_4', '4_-4', '0_4', '0_-4', '4_0', '-4_0', '-2_4', '2_-4', '2_2', '-2_-2', '4_-2', '-4_2', '-3_4', '3_-4', '3_1', '-3_-1'];
    }

    function conqQ(id) {
      return int(id.split('_')[0]);
    }

    function conqR(id) {
      return int(id.split('_')[1]);
    }

    // El doble de la distancia hexagonal (siempre entero)
    function conqD2(q, r) {
      return math.abs(q) + math.abs(r) + math.abs(q + r);
    }

    function conqTile(id) {
      return id is string && id.matches('^-?[0-4]_-?[0-4]$') && conqD2(conqQ(id), conqR(id)) <= 8;
    }

    function conqAdjacent(a, b) {
      return conqD2(conqQ(a) - conqQ(b), conqR(a) - conqR(b)) == 2;
    }

    function conqBandits(id) {
      return id == '0_0' ? 40 : 16 - conqD2(conqQ(id), conqR(id)) * 3 / 2;
    }

    function conqSince(old) {
      return request.time.toMillis() - old.t.toMillis();
    }

    // ¿Caben x tropas en la reserva? Lo guardado, o lo recargado sin pasar de 60.
    // Ojo: se divide entre 180000.0 (con decimales); entre dos enteros las reglas truncan.
    function conqTroopsFit(old, x) {
      return x <= old.troops || (x <= 60 && x <= old.troops + conqSince(old) / 180000.0);
    }

    match /conquest/{week}/members/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && conqOpen(week)
        && incoming().keys().hasOnly(['w'])
        && incoming().w is string && incoming().w.matches('^w[0-9]{1,3}$')
        && existsAfter(conqDoc(week, incoming().w, 'players', uid));
      allow delete: if isAdmin();
    }

    match /conquest/{week}/worlds/{w} {
      // Al unirse, el contador sube de uno en uno y el nuevo alcalde ocupa la casilla de capital siguiente
      function joining(count) {
        return request.auth != null
          && !exists(conqDoc(week, w, 'players', request.auth.uid))
          && getAfter(conqDoc(week, w, 'players', request.auth.uid)).data.slot == count;
      }

      // Un mundo nuevo solo se abre cuando el anterior (`prev`, que viene en el documento) está lleno:
      // w0 no necesita anterior; w{n} exige que w{n-1} exista con 16 alcaldes
      function prevFull(prev) {
        return prev is string && prev.matches('^w[0-9]{1,3}$')
          && w == 'w' + string(int(prev[1:prev.size()]) + 1)
          && get(/databases/$(database)/documents/conquest/$(week)/worlds/$(prev)).data.members >= 16;
      }

      allow read: if true;
      allow create: if conqOpen(week) && w.matches('^w[0-9]{1,3}$')
        && incoming().members == 1
        && ((w == 'w0' && incoming().keys().hasOnly(['members']))
          || (incoming().keys().hasOnly(['members', 'prev']) && prevFull(incoming().prev)))
        && joining(0);
      allow update: if conqOpen(week)
        && incoming().keys().hasOnly(['members', 'prev'])
        && (!('prev' in incoming()) || incoming().prev == resource.data.get('prev', null))
        && incoming().members == resource.data.members + 1 && incoming().members <= 16
        && joining(resource.data.members);
      allow delete: if isAdmin();
    }

    match /conquest/{week}/worlds/{w}/players/{uid} {
      function shape(d) {
        return d.keys().hasOnly(['name', 'slot', 'troops', 't', 'rDay', 'rToday', 'last', 'sent', 'aAt', 'aTo'])
          && d.keys().hasAll(['name', 'slot', 'troops', 't', 'rDay', 'rToday', 'last', 'sent'])
          && validName(d.name)
          && d.troops is number && d.troops >= 0 && d.troops <= 200
          && d.rToday is int && d.rToday >= 0 && d.rToday <= 45
          && d.sent is int && d.last is string && d.rDay is string
          && (!('aAt' in d) || d.aAt is timestamp)
          && (!('aTo' in d) || d.aTo is string);
      }

      function joined() {
        let d = incoming();
        return d.slot is int && d.slot >= 0 && d.slot < 16
          && d.slot == getAfter(/databases/$(database)/documents/conquest/$(week)/worlds/$(w)).data.members - 1
          && d.troops == 20 && d.t == request.time
          && d.rDay == '' && d.rToday == 0 && d.last == '' && d.sent == 0 && !('aAt' in d) && !('aTo' in d)
          && getAfter(/databases/$(database)/documents/conquest/$(week)/members/$(uid)).data.w == w
          && getAfter(conqDoc(week, w, 'tiles', conqSlots()[d.slot])).data.owner == uid;
      }

      // Envío de tropas: salen de la reserva (el territorio se valida en su propia regla)
      function sends() {
        let d = incoming();
        let old = resource.data;
        return d.sent >= 1 && d.t == request.time && conqTile(d.last)
          && d.rDay == old.rDay && d.rToday == old.rToday
          && conqTroopsFit(old, d.troops + d.sent);
      }

      // Ataque con bono de asalto: solo cambian `aAt` y `aTo` (el territorio atacado, para que un bono valga
      // para una sola conquista del lote), y como mucho uno cada 10 min (el territorio lo comprueba)
      function assault() {
        let old = resource.data;
        return onlyChanged(['aAt', 'aTo'])
          && incoming().aAt == request.time
          && 'aTo' in incoming() && conqTile(incoming().aTo)
          && (!('aAt' in old) || request.time > old.aAt + duration.value(10, 'm'));
      }

      // Reclutas por jugar: hasta 30 al día, 45 con la ley Militar (los declara el móvil; las reglas solo ponen el tope)
      function recruits() {
        let d = incoming();
        let old = resource.data;
        return d.t == request.time && d.sent == old.sent && d.last == old.last
          && d.rDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && dayNotFuture(d.rDay)
          && ((d.rDay == old.rDay && d.rToday > old.rToday && conqTroopsFit(old, d.troops - (d.rToday - old.rToday)))
            || (d.rDay > old.rDay && d.rToday >= 1 && conqTroopsFit(old, d.troops - d.rToday)));
      }

      allow read: if true;
      allow create: if isOwner(uid) && conqOpen(week) && shape(incoming()) && joined();
      allow update: if isOwner(uid) && conqOpen(week) && shape(incoming())
        && incoming().slot == resource.data.slot
        && (assault()
          || (incoming().get('aAt', null) == resource.data.get('aAt', null)
            && incoming().get('aTo', null) == resource.data.get('aTo', null)
            && (sends() || recruits() || onlyChanged(['name']))));
      allow delete: if isAdmin();
    }

    // Los soldados de un territorio crecen solos: 1 cada 4 min hasta 30; la capital, 1 cada 2 min hasta 60.
    // ¿Caben x soldados en el territorio `old`? Los que tenía, o los que tendría ahora sin pasar del tope.
    function conqGarrisonFit(old, x) {
      let cap = old.capital ? 60 : 30;
      let rate = old.capital ? 120000.0 : 240000.0;
      return x <= old.g || (x <= cap && x <= old.g + conqSince(old) / rate);
    }

    match /conquest/{week}/worlds/{w}/tiles/{tid} {
      // `to`/`sent`: el último ataque que salió de aquí; `from`/`sent`: de dónde llegaron los soldados;
      // `p`: fuerza con la que llegaron (los soldados por el bono del asalto)
      function shape(d) {
        return d.keys().hasOnly(['owner', 'name', 'g', 't', 'ct', 'capital', 'sent', 'from', 'to', 'p'])
          && d.keys().hasAll(['owner', 'name', 'g', 't', 'ct', 'capital', 'sent', 'from', 'to'])
          && d.owner == request.auth.uid && validName(d.name)
          && d.g is number && d.g >= 0 && d.capital is bool && d.sent is int && d.from is string && d.to is string
          && (!('p' in d) || d.p is int)
          && d.t == request.time;
      }

      function me() {
        return getAfter(conqDoc(week, w, 'players', request.auth.uid)).data;
      }

      // Fuerza del ataque: los soldados enviados, o hasta x1,5 con un bono de asalto apuntado en este lote
      // y dirigido a este territorio (`aTo`): un bono no sirve para varias conquistas del mismo lote
      function power() {
        let d = incoming();
        let p = d.get('p', d.sent);
        return p >= d.sent && p * 2 <= d.sent * 3
          && (p == d.sent || (me().get('aAt', null) == request.time && me().get('aTo', '') == tid));
      }

      // Ataque: los soldados salen en este mismo lote de un territorio propio vecino (`from`), que baja
      function fromTile() {
        let d = incoming();
        let f = getAfter(conqDoc(week, w, 'tiles', d.from)).data;
        return d.sent >= 1 && d.to == '' && conqTile(d.from) && conqAdjacent(d.from, tid)
          && f.owner == request.auth.uid && f.t == request.time && f.to == tid && f.sent == d.sent;
      }

      // Refuerzo: las tropas salen de la reserva en este mismo lote
      function fromReserve() {
        let d = incoming();
        let p = me();
        return d.sent >= 1 && d.to == '' && d.from == tid
          && p.t == request.time && p.last == tid && p.sent == d.sent;
      }

      // Capital de un alcalde que se une ahora
      function capital() {
        let d = incoming();
        let p = me();
        return !exists(conqDoc(week, w, 'players', request.auth.uid))
          && p.t == request.time && tid == conqSlots()[p.slot]
          && d.capital == true && d.g == 20 && d.ct == request.time && d.sent == 0 && d.from == '' && d.to == '';
      }

      // Territorio de bandidos (sin documento): la fuerza tiene que pasar su guarnición fija; quedan los
      // que sobran, sin pasar de los enviados
      function bandits() {
        let d = incoming();
        let p = d.get('p', d.sent);
        return !(tid in conqSlots()) && fromTile() && power()
          && d.capital == false && d.ct == request.time
          && p > conqBandits(tid) && d.g <= d.sent && d.g + conqBandits(tid) <= p
          && (d.g == d.sent || d.g + conqBandits(tid) == p);
      }

      // Salida de un ataque: el territorio propio pierde los soldados que manda al vecino `to`
      function dispatch() {
        let d = incoming();
        let old = resource.data;
        return old.owner == request.auth.uid && d.capital == old.capital && d.ct == old.ct
          && d.from == '' && d.sent >= 1 && conqTile(d.to) && conqAdjacent(tid, d.to)
          && conqGarrisonFit(old, d.g + d.sent);
      }

      // Refuerzo de un territorio propio desde la reserva: suma lo enviado a lo que tenía
      function reinforce() {
        let d = incoming();
        let old = resource.data;
        return old.owner == request.auth.uid && fromReserve()
          && d.capital == old.capital && d.ct == old.ct
          && conqGarrisonFit(old, d.g - d.sent);
      }

      // Conquista de un territorio de otro alcalde (nunca su capital ni bajo escudo)
      function capture() {
        let d = incoming();
        let old = resource.data;
        let grown = old.g + conqSince(old) / 240000.0;
        let p = d.get('p', d.sent);
        return old.owner != request.auth.uid && old.capital == false
          && request.time > old.ct + duration.value(30, 'm') && fromTile() && power()
          && d.capital == false && d.ct == request.time
          && p > old.g && (p > 30 || p > grown)
          && d.g <= d.sent && d.g + old.g <= p && (d.g + 30 <= p || d.g + grown <= p);
      }

      allow read: if true;
      allow create: if request.auth != null && conqOpen(week) && conqTile(tid) && shape(incoming()) && (capital() || bandits());
      allow update: if request.auth != null && conqOpen(week) && shape(incoming()) && (dispatch() || reinforce() || capture());
      allow delete: if isAdmin();
    }

    // Partes de batalla: los escribe quien conquista un territorio de {uid}, en el mismo lote que la
    // conquista. Solo los lee el alcalde que lo perdió. El id es el territorio: un único parte por
    // conquista (si lo pierde otra vez más tarde, el parte se sobrescribe con la misma validación).
    match /conquest/{week}/worlds/{w}/players/{uid}/reports/{rid} {
      function validReport() {
        let d = incoming();
        let tile = /databases/$(database)/documents/conquest/$(week)/worlds/$(w)/tiles/$(d.tile);
        return d.keys().hasOnly(['by', 'name', 'tile', 'at']) && d.keys().hasAll(['by', 'name', 'tile', 'at'])
          && rid == d.tile
          && d.by == request.auth.uid && uid != request.auth.uid
          && validName(d.name) && conqTile(d.tile) && d.at == request.time
          && get(tile).data.owner == uid
          && getAfter(tile).data.owner == request.auth.uid && getAfter(tile).data.t == request.time;
      }

      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if request.auth != null && conqOpen(week) && validReport();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Sugerencias: cualquier jugador puede enviar (máximo una por minuto);
    // solo el administrador puede leerlas, cambiarles el estado o borrarlas.
    // ------------------------------------------------------------------
    match /suggestions/{id} {
      function validSuggestion() {
        let d = incoming();
        return d.keys().hasOnly(['uid', 'name', 'kind', 'text', 'era', 'ua', 'status', 'createdAt'])
          && d.keys().hasAll(['uid', 'name', 'kind', 'text', 'status', 'createdAt'])
          && d.uid == request.auth.uid
          && validName(d.name)
          && d.kind in ['idea', 'bug', 'otro']
          && d.text is string && d.text.size() >= 5 && d.text.size() <= 1000
          && (!('era' in d) || (d.era is int && d.era >= 1))
          && (!('ua' in d) || (d.ua is string && d.ua.size() <= 200))
          && d.status == 'nuevo'
          && d.createdAt == request.time
          // El mismo lote tiene que marcar la hora del envío en suggestionMeta (que limita a uno por minuto)
          && getAfter(/databases/$(database)/documents/suggestionMeta/$(request.auth.uid)).data.lastAt == request.time;
      }

      allow create: if request.auth != null && validSuggestion();
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && onlyChanged(['status'])
        && incoming().status in ['nuevo', 'leido', 'hecho', 'descartado'];
    }

    match /suggestionMeta/{uid} {
      function validMeta() {
        return incoming().keys().hasOnly(['lastAt']) && incoming().lastAt == request.time;
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validMeta();
      allow update: if isOwner(uid) && validMeta() && request.time > resource.data.lastAt + duration.value(60, 's');
      // Al eliminar una cuenta
      allow delete: if isAdmin();
    }

    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
